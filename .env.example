# Copy to .env and fill in real values. docker-compose reads this file
# automatically for ${VAR} interpolation. Never commit the populated .env.

# Flask signing key. Tokens are HS256-signed with this — must be long & random.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# Optional: separate key for flask-jwt-extended. Defaults to SECRET_KEY if unset.
JWT_SECRET_KEY=

# PostgreSQL credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leviathan_db

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Shared secret for trusted service-to-service calls (AI/MCP -> backend).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-value
